    given-names: Adam Youlin
    email: ayhe@stanford.edu
version: 0.1.0.dev0
license: MIT
repository-code: "https://github.com/adamyhe/dienr"
keywords:
  - nascent RNA
  - PRO-seq
  - GRO-seq
  - pre-RNA isoforms
  - transcription
  - bioinformatics
references:
  - type: article
    title: >-
      Deconvolution of expression for nascent RNA-sequencing data (DENR)
      highlights pre-RNA isoform diversity in human cells
